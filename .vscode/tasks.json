{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: gcc compila il file attivo",
      "command": "make",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "Attività generata dal debugger."
    },
    {
      "type": "cppbuild",
      "label": "C/C++: gcc-13 compila il file attivo",
      "command": "/usr/bin/gcc-13",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Attività generata dal debugger."
    }
  ],
  "version": "2.0.0"
}